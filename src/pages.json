{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "首页",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/categories/categories",
      "style": {
        "navigationBarTitleText": "奇妙本",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/calendar/calendar",
      "style": {
        "navigationBarTitleText": "日历",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/profile/profile",
      "style": {
        "navigationBarTitleText": "我的",
        "enablePullDownRefresh": false
      }
    }
  ],
  "subPackages": [
    {
      "root": "subpackages/book-edit",
      "pages": [
        {
          "path": "book-edit",
          "style": {
            "navigationBarTitleText": "编辑奇妙本",
            "enablePullDownRefresh": false
          }
        }
      ]
    },
    {
      "root": "subpackages/detail",
      "pages": [
        {
          "path": "detail",
          "style": {
            "navigationBarTitleText": "奇妙日详情",
            "enablePullDownRefresh": false
          }
        },
         {
          "path": "sharedetail",
          "style": {
            "navigationBarTitleText": "奇妙日分享",
            "enablePullDownRefresh": false
          }
        }
      ]
    },
    {
      "root": "subpackages/edit",
      "pages": [
        {
          "path": "edit",
          "style": {
            "navigationBarTitleText": "编辑奇妙日",
            "enablePullDownRefresh": false
          }
        }
      ]
    },
    {
      "root": "subpackages/login",
      "pages": [
        {
          "path": "login",
          "style": {
            "navigationBarTitleText": "登录",
            "enablePullDownRefresh": false
          }
        },
           {
          "path": "pwdlogin",
          "style": {
            "navigationBarTitleText": "登录",
            "enablePullDownRefresh": false
          }
        }
      ]
    },
    {
      "root": "subpackages/register",
      "pages": [
        {
          "path": "register",
          "style": {
            "navigationBarTitleText": "注册",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "reginfo",
          "style": {
            "navigationBarTitleText": "填写信息开启奇妙日",
            "enablePullDownRefresh": false
          }
        }
      ]
    },
    {
      "root": "subpackages/event-edit",
      "pages": [
        {
          "path": "event-edit",
          "style": {
            "navigationBarTitleText": "注册",
            "enablePullDownRefresh": false
          }
        }
      ]
    },
    {
      "root": "subpackages/customer-service",
      "pages": [
        {
          "path": "customer-service",
          "style": {
            "navigationBarTitleText": "联系客服",
            "enablePullDownRefresh": false
          }
        }
      ]
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "",
    "navigationBarBackgroundColor": "#1890ff",
    "backgroundColor": "#f0f7ff"
  },
  "tabBar": {
    "color": "#aaaaaa",
    "selectedColor": "#1890ff",
    "borderStyle": "black",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "/static/home.png",
        "selectedIconPath": "/static/home-active.png"
      },
      {
        "pagePath": "pages/categories/categories",
        "text": "奇妙本",
        "iconPath": "/static/book.png",
        "selectedIconPath": "/static/book-active.png"
      },
      {
        "pagePath": "pages/calendar/calendar",
        "text": "日历",
        "iconPath": "/static/calendar.png",
        "selectedIconPath": "/static/calendar-active.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "/static/profile.png",
        "selectedIconPath": "/static/profile-active.png"
      }
    ]
  }
}